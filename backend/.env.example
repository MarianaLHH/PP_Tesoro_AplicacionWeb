# Copiar como backend/.env para desarrollo local.

# Con `docker compose up -d db`:
DATABASE_URL="postgresql://tesoro:tesoro@localhost:5433/tesoro?schema=public"
# Con el PostgreSQL instalado en Windows (ajusta usuario y clave):
# DATABASE_URL="postgresql://tesoro:TU_CLAVE@localhost:5432/tesoro?schema=public"

JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="8h"

# Administrador inicial: se crea SOLO si la tabla de usuarios está vacía.
# Después de crearlo estas variables se ignoran (se pueden borrar).
ADMIN_EMAIL="admin@tesoro.local"
ADMIN_PASSWORD="cambiar-esta-clave"
ADMIN_NOMBRE="Administrador"
PORT=3000

# Sólo si la PWA se sirve desde otro dominio (separados por coma):
# CORS_ORIGINS="https://app.midominio.com"
